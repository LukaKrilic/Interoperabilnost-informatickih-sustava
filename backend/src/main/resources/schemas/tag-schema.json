{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algebra.hr/interop/tag-schema.json",
  "title": "Tags import",
  "type": "object",
  "required": ["tags"],
  "additionalProperties": false,
  "properties": {
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "gid": { "type": "string", "maxLength": 30 },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "color": { "enum": ["dark-red", "dark-orange", "light-green",
            "dark-blue", "light-purple", "none"] },
          "notes": { "type": "string" },
          "workspaceGid": { "type": "string", "maxLength": 30 }
        }
      }
    }
  }
}